# ---------------------------------------------------------------------------
# VerseBill environment — placeholder names only. Never put real secrets here.
# Copy to .env.local for development. All secrets stay server-side.
# ---------------------------------------------------------------------------

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Official VerseBill X (Twitter) profile URL. Leave empty until the official
# handle/URL is supplied; the footer hides the X link while it is unset.
NEXT_PUBLIC_X_URL=

# Database — Supabase Postgres. Secrets stay server-side.
# DIRECT_URL: session/direct (migrations). Prefer the IPv4 pooler :5432 if db.* is IPv6-only.
# DATABASE_URL: transaction pooler :6543 for the app (pgbouncer=true).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Privy — create an app at https://dashboard.privy.io
# NEXT_PUBLIC_* is the app ID only. The secret must never be public.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional. Copy from Privy Dashboard → Configuration → App settings.
# Avoids a Privy API call on every token verification.
# Store PEM as a single quoted line with \n for newlines.
PRIVY_VERIFICATION_KEY=
# Production only, after Privy HttpOnly cookies + DNS are enabled.
# Local/dev uses localStorage tokens; leaving this unset avoids a /refresh bounce after login.
PRIVY_USE_HTTPONLY_COOKIES=false

# Network mode: "demo" or "production"
# production = Polygon PoS mainnet + official VERSE (real money)
# demo = operator-supplied test chain + test ERC-20 (must be a real contract)
VERSE_NETWORK_MODE=demo
NEXT_PUBLIC_NETWORK_MODE=demo

# Production / Buildathon (Polygon PoS). Used when VERSE_NETWORK_MODE=production.
# These are the trusted values. Clients cannot override them.
VERSE_CHAIN_ID=137
VERSE_TOKEN_ADDRESS=0xc708d6f2153933daa50b2d0758955be0a93a8fec
VERSE_TOKEN_DECIMALS=18
VERSE_TOKEN_SYMBOL=VERSE
VERSE_EXPLORER_URL=https://polygonscan.com
VERSE_CHAIN_NAME=Polygon PoS
VERSE_GAS_TOKEN=POL
VERSE_MINIMUM_USD=1
VERSE_PRICE_CACHE_MS=45000

# CoinGecko is queried server-side with the public simple/token_price URL.
# No API key is required. Optional key only if you hit public rate limits.
# COINGECKO_API_KEY=

# Server-side RPC. Never expose privileged RPC credentials to the browser.
# Required for payment verification. Public wallet RPC (Privy) is separate.
# Example: Alchemy Polygon mainnet https://polygon-mainnet.g.alchemy.com/v2/<key>
POLYGON_RPC_URL=
RPC_URL=

# Confirmations required before PAID. Polygon blocks are ~2s.
# This is probabilistic finality, not the Ethereum checkpoint.
VERSE_REQUIRED_CONFIRMATIONS=30

# Demo / testnet — required when VERSE_NETWORK_MODE=demo
# Must be a real chain and a real ERC-20. Do not invent a token address.
DEMO_CHAIN_ID=
DEMO_CHAIN_NAME=Polygon Amoy
DEMO_TOKEN_ADDRESS=
DEMO_TOKEN_DECIMALS=18
DEMO_TOKEN_SYMBOL=VERSE
DEMO_EXPLORER_URL=https://amoy.polygonscan.com
DEMO_RPC_URL=
DEMO_GAS_TOKEN=POL
DEMO_REQUIRED_CONFIRMATIONS=5

# Cron worker (Vercel Cron / Authorization: Bearer)
CRON_SECRET=

# Optional: HMAC secret for signed internal/webhook requests
WEBHOOK_HMAC_SECRET=

# Optional: allowlist of Origins for state-changing API requests (comma-separated)
# Defaults to APP_URL
ALLOWED_ORIGINS=

# Optional Resend (email share). Instantiated inside the handler, never at module load.
RESEND_API_KEY=
RESEND_FROM=

# Optional. Server-only EOA that tops up POL so users can sign transfers.
# Never put this key in git or chat. Hex, with or without 0x.
# The wallet must hold POL on the configured chain.
GAS_SPONSOR_PRIVATE_KEY=
# POL sent when a payer is below ~0.015 POL. Default 0.02. Max 0.2.
GAS_SPONSOR_TOP_UP_POL=0.02

# Verse App Analytics — leave empty until official docs/SDK/endpoint are provided.
# The app will store events locally and will not call a guessed URL.
VERSE_ANALYTICS_ENDPOINT=
VERSE_ANALYTICS_KEY=

# Verse Analytics (official) — Plausible-compatible script from analytics.vgdh.io.
# The production site hostname ONLY (no scheme, no path, no trailing slash), e.g. versebill.xyz.
# Empty = script is not rendered. Only rendered in production builds, never in `next dev`.
NEXT_PUBLIC_VERSE_ANALYTICS_DOMAIN=
