{
  "name": "versebill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:turbo": "next dev --turbopack --port 3000",
    "build": "prisma generate && NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "vercel-build": "NODE_ENV=production prisma migrate deploy && NODE_ENV=production next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@privy-io/node": "^0.28.0",
    "@privy-io/react-auth": "^3.6.1",
    "lucide-react": "^1.31.0",
    "next": "^15.5.23",
    "opencode-ai": "^1.18.18",
    "prisma": "^6.12.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "^2.55.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
