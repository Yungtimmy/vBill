generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MERCHANT
  ADMIN
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PROCESSING
  PAID
  UNDERPAID
  OVERPAID
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PROCESSING
  CONFIRMED
  REJECTED
  FAILED
}

model User {
  id            String     @id @default(cuid())
  privyUserId   String     @unique
  email         String?
  walletAddress String?
  role          Role       @default(MERCHANT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  merchant      Merchant?
  auditLogs     AuditLog[]
}

model Merchant {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String     @default("")
  businessEmail String?
  walletAddress String
  invoiceSeq    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  invoices      Invoice[]

  @@index([walletAddress])
}

model Invoice {
  id              String        @id @default(cuid())
  publicId        String        @unique
  invoiceNumber   String
  merchantId      String
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customerName    String
  customerEmail   String?
  currency        String        @default("VERSE")
  amountBaseUnits String
  tokenAddress    String
  chainId         Int
  merchantWallet  String
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?
  notes           String?
  lineItems       Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payments        Payment[]
  auditLogs       AuditLog[]

  @@unique([merchantId, invoiceNumber])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([status])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  txHash          String
  chainId         Int
  tokenAddress    String?
  fromAddress     String?
  toAddress       String?
  amountBaseUnits String?
  blockNumber     String?
  confirmations   Int           @default(0)
  status          PaymentStatus @default(PROCESSING)
  rejectReason    String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([chainId, txHash])
  @@index([invoiceId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([invoiceId])
  @@index([event, createdAt])
}
